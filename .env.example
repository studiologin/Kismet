# ─────────────────────────────────────────────────────────────
# Kismet Score — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas
# chaves na Vercel (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ID da planilha "KISMET RESULTADOS" — é o trecho entre /d/ e /edit na URL:
# https://docs.google.com/spreadsheets/d/<ESTE_ID>/edit
GOOGLE_SHEET_ID=1eFT6j8de6Cv_6fUCL9ENhB0ga3i4L-2ljqdoxH4brS4

# Aba onde as partidas são gravadas (criada automaticamente se não existir)
GOOGLE_SHEET_TAB=Partidas

# Aba antiga com o histórico em colunas — lida automaticamente junto com a aba de partidas
GOOGLE_LEGACY_TAB=Nucha & Manoel
# Ano das partidas da aba antiga (opcional, padrão 2026)
GOOGLE_LEGACY_YEAR=2026

# Service Account (Google Cloud → IAM → Service Accounts → Keys → JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=kismet-score@seu-projeto.iam.gserviceaccount.com
# Cole a "private_key" do JSON entre aspas, mantendo os \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI\n-----END PRIVATE KEY-----\n"

# PIN para acessar /registrar (4 a 8 dígitos)
ADMIN_PIN=1234

# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
